rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isValidRole(role) {
      return role in ['admin', 'einsatzleitung', 'responder', 'observer', 'group_leader'];
    }

    function isValidOperationStatus(status) {
      return status in ['planned', 'active', 'paused', 'completed', 'archived', 'aborted'];
    }

    function isValidOperationType(type) {
      return type in ['operation', 'exercise', 'live_search'];
    }

    function isValidArrivalStatus(status) {
      return status == null || status in ['', 'in_transit', 'near_ez', 'ez_reached', 'ready'];
    }

    function isValidCoordinate(lat, lng) {
      return lat >= -90.0 && lat <= 90.0 && lng >= -180.0 && lng <= 180.0;
    }

    // Users Collection
    match /users/{userId} {
      allow read: if true;
      allow create, update: if true;
      // First Admin / Owner account (user-maria) cannot be deleted under any circumstances
      allow delete: if userId != 'user-maria';
    }

    // Operations Collection
    match /operations/{operationId} {
      allow read: if true;
      allow create, update: if request.resource.data.id is string
        && request.resource.data.title is string
        && request.resource.data.title.size() <= 200
        && isValidOperationStatus(request.resource.data.status)
        && isValidOperationType(request.resource.data.type);
      allow delete: if true;
    }

    // Live GPS & Telemetry Locations
    match /user_locations/{userId} {
      allow read: if true;
      allow create, update: if request.resource.data.userId is string
        && request.resource.data.isLive is bool
        && request.resource.data.currentPosition != null
        && isValidCoordinate(request.resource.data.currentPosition.lat, request.resource.data.currentPosition.lng);
      allow delete: if true;
    }

    // Tactical Chat Transmissions, System Logs & Broadcasts
    match /chat_messages/{messageId} {
      allow read: if true;
      allow create, update: if request.resource.data.id is string
        && request.resource.data.senderId is string
        && request.resource.data.senderName is string
        && (!('text' in request.resource.data) || (request.resource.data.text is string && request.resource.data.text.size() <= 3000));
      allow delete: if true;
    }

    // Global Settings & Configurations
    match /settings/{settingId} {
      allow read, write: if true;
    }
  }
}
